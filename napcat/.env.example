# NapCat WebUI token. 启动前建议复制为 .env 并改成自己的随机字符串。
NAPCAT_WEBUI_TOKEN=change-me

# 可选：用于反向 WebSocket 上报到你自己的服务。
# NAPCAT_ONEBOT_WS_URL=ws://host.docker.internal:8080/onebot

# hobby-box 后端 QQ 群监控 HTTP 回调 token。
# 需要和 hobby-box 的 QQ_ONEBOT_CALLBACK_TOKEN 保持一致。
QQ_ONEBOT_CALLBACK_TOKEN=change-me

# OneBot HTTP 事件上报地址。留空时脚本会按下面规则生成：
# https://api.fantuanpu.com/callback/qq/onebot?token=${QQ_ONEBOT_CALLBACK_TOKEN}
NAPCAT_ONEBOT_HTTP_URL=

# 是否上报机器人自己发出的消息。
NAPCAT_ONEBOT_REPORT_SELF_MESSAGE=false
